  private
    FAbertas: TFPList;
    FOnImprimirDANFE: TImprimirDANFEEvent;
    procedure AbrirDetalhe(Detalhe: TDataSet);
    procedure SetOnImprimirDANFE(AValue: TImprimirDANFEEvent);
  public
    class procedure Exibir(AoImprimirDANFE: TImprimirDANFEEvent = nil);
    property OnImprimirDANFE: TImprimirDANFEEvent read FOnImprimirDANFE write SetOnImprimirDANFE;
  end;

var
  frmNFeDetalhes: TfrmNFeDetalhes;

implementation

uses
  Dialogs, udmdnfe;

{$R *.lfm}

{ TfrmNFeDetalhes }

class procedure TfrmNFeDetalhes.Exibir(AoImprimirDANFE: TImprimirDANFEEvent);
begin
  if not dmdNFe.qryNFeCab.Active or dmdNFe.qryNFeCab.IsEmpty then
    Exit;
  frmNFeDetalhes := TfrmNFeDetalhes.Create(Application);
  try
    frmNFeDetalhes.OnImprimirDANFE := AoImprimirDANFE;
    frmNFeDetalhes.ShowModal;
  finally
    FreeAndNil(frmNFeDetalhes);
  end;
end;

procedure TfrmNFeDetalhes.FormCreate(Sender: TObject);
begin
  FAbertas := TFPList.Create;
  // detalhes ligados a dtsNFeCab: abertos aqui acompanham a nota selecionada em qryNFeCab
  AbrirDetalhe(dmdNFe.qryNFeDet);
  AbrirDetalhe(dmdNFe.qryNFeFat);
  AbrirDetalhe(dmdNFe.qryNFeDup);
  AbrirDetalhe(dmdNFe.qryNFeVol);
  AbrirDetalhe(dmdNFe.qryNFePgt);
end;

procedure TfrmNFeDetalhes.FormDestroy(Sender: TObject);
var
  I: integer;
begin
  // fecha somente o que este form abriu; abertas, as queries seriam reabertas a cada
  // movimentação do grid principal
  for I := 0 to FAbertas.Count - 1 do
    TDataSet(FAbertas[I]).Close;
  FAbertas.Free;
end;

procedure TfrmNFeDetalhes.tbtImprimirClick(Sender: TObject);
begin
  if not Assigned(FOnImprimirDANFE) then
    Exit;
  try
    FOnImprimirDANFE(dmdNFe.qryNFeCab.FieldByName('CHNFE').AsString);
  except
    on E: Exception do
      MessageDlg(E.Message, mtError, [mbOK], 0);
  end;
end;

procedure TfrmNFeDetalhes.SetOnImprimirDANFE(AValue: TImprimirDANFEEvent);
begin
  FOnImprimirDANFE := AValue;
  // sem quem imprima (ex.: form criado fora do frmMain) o botão fica desabilitado
  tbtImprimir.Enabled := Assigned(FOnImprimirDANFE);
end;

procedure TfrmNFeDetalhes.AbrirDetalhe(Detalhe: TDataSet);
begin
  if Detalhe.Active then
    Exit;
  Detalhe.Open;
  FAbertas.Add(Detalhe);
end;

end.
