      '  AVULSA_NDAR VARCHAR(60),'
      '  AVULSA_DEMI DATE,'
      '  AVULSA_VDAR NUMERIC(15,2),'
      '  AVULSA_REPEMI VARCHAR(60),'
      '  AVULSA_DPAG DATE,'
      '  DEST_CNPJCPF VARCHAR(14),'
      '  DEST_IDESTRANGEIRO VARCHAR(20),'
      '  DEST_XNOME VARCHAR(60),'
      '  DEST_XLGR VARCHAR(60),'
      '  DEST_NRO VARCHAR(60),'
      '  DEST_XCPL VARCHAR(60),'
      '  DEST_XBAIRRO VARCHAR(60),'
      '  DEST_CMUN INTEGER,'
      '  DEST_XMUN VARCHAR(60),'
      '  DEST_UF VARCHAR(2),'
      '  DEST_CEP INTEGER,'
      '  DEST_CPAIS INTEGER,'
      '  DEST_XPAIS VARCHAR(60),'
