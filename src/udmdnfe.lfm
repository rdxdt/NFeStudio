      '  VEICTRANSP_RNTC, TRANSP_VAGAO, TRANSP_BALSA, PAG_VTROCO, INTERMED_CNPJ, INTERMED_IDCADINTTRAN,'
      '  INFADIC_INFADFISCO, INFADIC_INFCPL, EXPORTA_UFEMBARQ, EXPORTA_XLOCEMBARQ, EXPORTA_UFSAIDAPAIS, EXPORTA_XLOCEXPORTA,'
