  object cmdDelNFeCab: TZQuery
    Connection = frmMain.ZConnection1
    SQL.Strings = (
      'DELETE FROM NFE_CAB'
      ' WHERE CHNFE = :CHNFE'
    )
    Params = <
      item
        DataType = ftString
        Name = 'CHNFE'
        ParamType = ptInput
      end>
    Left = 32
    Top = 230
  end
