  object qryNFeCab: TZQuery
    Connection = frmMain.ZConnection1
    SQL.Strings = (
      'SELECT *'
      '  FROM NFE_CAB'
      ' WHERE IDE_DHEMI >= :DATA_INICIAL'
      '   AND IDE_DHEMI < DATE(:DATA_FINAL, ''+1 day'')'
      ' ORDER BY IDE_DHEMI, IDE_SERIE, IDE_NNF'
    )
    Params = <
      item
        DataType = ftDate
        Name = 'DATA_INICIAL'
        ParamType = ptInput
      end
      item
        DataType = ftDate
        Name = 'DATA_FINAL'
        ParamType = ptInput
      end>
    Left = 32
    Top = 17
