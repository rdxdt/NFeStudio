  object cmdInsNFeCab: TZQuery
    Connection = frmMain.ZConnection1
    SQL.Strings = (
      'INSERT INTO NFE_CAB ('
      '  CHNFE, VERSAO, IDE_CUF, IDE_CNF, IDE_NATOP, IDE_INDPAG,'
      '  IDE_MOD, IDE_SERIE, IDE_NNF, IDE_DHEMI, IDE_DHSAIENT, IDE_HSAIENT,'
      '  IDE_TPNF, IDE_IDDEST, IDE_CMUNFG, IDE_TPIMP, IDE_TPEMIS, IDE_CDV,'
      '  IDE_TPAMB, IDE_FINNFE, IDE_INDFINAL, IDE_INDPRES, IDE_INDINTERMED, IDE_PROCEMI,'
      '  IDE_VERPROC, IDE_DHCONT, IDE_XJUST, IDE_CMUNFGIBS, IDE_TPNFDEBITO, IDE_TPNFCREDITO,'
      '  COMPRAGOV_TPENTEGOV, COMPRAGOV_PREDUTOR, COMPRAGOV_TPOPERGOV, EMIT_CNPJCPF, EMIT_XNOME, EMIT_XFANT,'
      '  EMIT_XLGR, EMIT_NRO, EMIT_XCPL, EMIT_XBAIRRO, EMIT_CMUN, EMIT_XMUN,'
      '  EMIT_UF, EMIT_CEP, EMIT_CPAIS, EMIT_XPAIS, EMIT_FONE, EMIT_IE,'
      '  EMIT_IEST, EMIT_IM, EMIT_CNAE, EMIT_CRT, AVULSA_CNPJ, AVULSA_XORGAO,'
      '  AVULSA_MATR, AVULSA_XAGENTE, AVULSA_FONE, AVULSA_UF, AVULSA_NDAR, AVULSA_DEMI,'
      '  AVULSA_VDAR, AVULSA_REPEMI, AVULSA_DPAG, DEST_CNPJCPF, DEST_IDESTRANGEIRO, DEST_XNOME,'
      '  DEST_XLGR, DEST_NRO, DEST_XCPL, DEST_XBAIRRO, DEST_CMUN, DEST_XMUN,'
      '  DEST_UF, DEST_CEP, DEST_CPAIS, DEST_XPAIS, DEST_FONE, DEST_INDIEDEST,'
      '  DEST_IE, DEST_ISUF, DEST_IM, DEST_EMAIL, RETIRADA_CNPJCPF, RETIRADA_XNOME,'
      '  RETIRADA_XLGR, RETIRADA_NRO, RETIRADA_XCPL, RETIRADA_XBAIRRO, RETIRADA_CMUN, RETIRADA_XMUN,'
      '  RETIRADA_UF, RETIRADA_CEP, RETIRADA_CPAIS, RETIRADA_XPAIS, RETIRADA_FONE, RETIRADA_EMAIL,'
      '  RETIRADA_IE, ENTREGA_CNPJCPF, ENTREGA_XNOME, ENTREGA_XLGR, ENTREGA_NRO, ENTREGA_XCPL,'
      '  ENTREGA_XBAIRRO, ENTREGA_CMUN, ENTREGA_XMUN, ENTREGA_UF, ENTREGA_CEP, ENTREGA_CPAIS,'
      '  ENTREGA_XPAIS, ENTREGA_FONE, ENTREGA_EMAIL, ENTREGA_IE, TOT_VBC, TOT_VICMS,'
      '  TOT_VICMSDESON, TOT_VFCPUFDEST, TOT_VICMSUFDEST, TOT_VICMSUFREMET, TOT_VFCP, TOT_VBCST,'
      '  TOT_VST, TOT_VFCPST, TOT_VFCPSTRET, TOT_VPROD, TOT_VFRETE, TOT_VSEG,'
      '  TOT_VDESC, TOT_VII, TOT_VIPI, TOT_VIPIDEVOL, TOT_VPIS, TOT_VCOFINS,'
      '  TOT_VOUTRO, TOT_VNF, TOT_VTOTTRIB, TOT_VICMSMONO, TOT_VICMSMONORETEN, TOT_VICMSMONORET,'
      '  TOT_QBCMONO, TOT_QBCMONORETEN, TOT_QBCMONORET, TOT_VNFTOT, ISSQNTOT_VSERV, ISSQNTOT_VBC,'
      '  ISSQNTOT_VISS, ISSQNTOT_VPIS, ISSQNTOT_VCOFINS, ISSQNTOT_DCOMPET, ISSQNTOT_VDEDUCAO, ISSQNTOT_VOUTRO,'
      '  ISSQNTOT_VDESCINCOND, ISSQNTOT_VDESCCOND, ISSQNTOT_VISSRET, ISSQNTOT_CREGTRIB, RETTRIB_VRETPIS, RETTRIB_VRETCOFINS,'
      '  RETTRIB_VRETCSLL, RETTRIB_VBCIRRF, RETTRIB_VIRRF, RETTRIB_VBCRETPREV, RETTRIB_VRETPREV, ISTOT_VIS,'
      '  IBSCBSTOT_VBCIBSCBS, IBSUFTOT_VDIF, IBSUFTOT_VDEVTRIB, IBSUFTOT_VIBSUF, IBSMUNTOT_VDIF, IBSMUNTOT_VDEVTRIB,'
