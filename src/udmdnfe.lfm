  object sqlCreateTables: TZSQLProcessor
    Params = <>
    Script.Strings = (
      'CREATE TABLE IF NOT EXISTS NFE_CAB ('
      '  CHNFE VARCHAR(44) NOT NULL PRIMARY KEY,'
      '  VERSAO NUMERIC(4,2),'
      '  IDE_CUF INTEGER,'
      '  IDE_CNF INTEGER,'
      '  IDE_NATOP VARCHAR(60),'
      '  IDE_INDPAG VARCHAR(1),'
      '  IDE_MOD INTEGER,'
      '  IDE_SERIE INTEGER,'
      '  IDE_NNF INTEGER,'
      '  IDE_DHEMI DATETIME,'
      '  IDE_DHSAIENT DATETIME,'
      '  IDE_HSAIENT TIME,'
      '  IDE_TPNF VARCHAR(1),'
      '  IDE_IDDEST VARCHAR(1),'
      '  IDE_CMUNFG INTEGER,'
      '  IDE_TPIMP VARCHAR(1),'
      '  IDE_TPEMIS VARCHAR(1),'
      '  IDE_CDV INTEGER,'
      '  IDE_TPAMB VARCHAR(1),'
      '  IDE_FINNFE VARCHAR(1),'
      '  IDE_INDFINAL VARCHAR(1),'
      '  IDE_INDPRES VARCHAR(1),'
      '  IDE_INDINTERMED VARCHAR(1),'
      '  IDE_PROCEMI VARCHAR(1),'
      '  IDE_VERPROC VARCHAR(20),'
      '  IDE_DHCONT DATETIME,'
      '  IDE_XJUST VARCHAR(256),'
      '  IDE_CMUNFGIBS INTEGER,'
      '  IDE_TPNFDEBITO VARCHAR(2),'
      '  IDE_TPNFCREDITO VARCHAR(2),'
      '  COMPRAGOV_TPENTEGOV VARCHAR(1),'
      '  COMPRAGOV_PREDUTOR NUMERIC(7,4),'
      '  COMPRAGOV_TPOPERGOV VARCHAR(1),'
      '  EMIT_CNPJCPF VARCHAR(14),'
      '  EMIT_XNOME VARCHAR(60),'
      '  EMIT_XFANT VARCHAR(60),'
      '  EMIT_XLGR VARCHAR(60),'
      '  EMIT_NRO VARCHAR(60),'
      '  EMIT_XCPL VARCHAR(60),'
      '  EMIT_XBAIRRO VARCHAR(60),'
      '  EMIT_CMUN INTEGER,'
      '  EMIT_XMUN VARCHAR(60),'
      '  EMIT_UF VARCHAR(2),'
      '  EMIT_CEP INTEGER,'
      '  EMIT_CPAIS INTEGER,'
      '  EMIT_XPAIS VARCHAR(60),'
      '  EMIT_FONE VARCHAR(14),'
      '  EMIT_IE VARCHAR(14),'
      '  EMIT_IEST VARCHAR(14),'
      '  EMIT_IM VARCHAR(15),'
      '  EMIT_CNAE VARCHAR(7),'
      '  EMIT_CRT VARCHAR(1),'
      '  AVULSA_CNPJ VARCHAR(14),'
      '  AVULSA_XORGAO VARCHAR(60),'
      '  AVULSA_MATR VARCHAR(60),'
      '  AVULSA_XAGENTE VARCHAR(60),'
