      '  DEST_ISUF VARCHAR(9),'
      '  DEST_IM VARCHAR(15),'
      '  DEST_EMAIL VARCHAR(60),'
      '  RETIRADA_CNPJCPF VARCHAR(14),'
      '  RETIRADA_XNOME VARCHAR(60),'
      '  RETIRADA_XLGR VARCHAR(60),'
